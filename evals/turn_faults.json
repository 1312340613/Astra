    {
      "id": "ordered-write-read",
      "responses": [
        {
          "frames": [
            {
              "calls": [
                {
                  "index": 0,
                  "id": "a",
                  "name": "fixture_read",
                  "arguments": "{}"
                },
                {
                  "index": 1,
                  "id": "b",
                  "name": "fixture_write",
                  "arguments": "{\"value\": \"after\"}"
                },
                {
                  "index": 2,
                  "id": "c",
                  "name": "fixture_read",
                  "arguments": "{}"
                }
              ],
              "finish": "tool_calls"
            }
          ]
        },
        {
          "frames": [
            {
              "content": "REPLAY VERIFIED",
              "finish": "stop"
            }
          ],
          "expect_tool_text": "after"
        }
      ],
      "expected": {
        "requests": 2,
        "writes": [
          "after"
        ],
        "reads": [
          "before",
          "after"
        ]
      }
    },
