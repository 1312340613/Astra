{
  "manifest_version": 3,
  "name": "Astra Activity URLs",
  "version": "0.1.0",
  "description": "Opt-in foreground page title and URL for your local Astra activity recorder.",
  "minimum_chrome_version": "120",
  "incognito": "not_allowed",
  "permissions": ["tabs", "storage", "alarms"],
  "host_permissions": ["http://127.0.0.1:8089/*"],
  "background": {"service_worker": "worker.js"},
  "options_page": "options.html",
  "action": {"default_title": "Configure Astra Activity URLs"}
}
